# Base de données Turso (libSQL hébergé) — créer sur turso.tech
# Token : turso db tokens create <nom-de-la-base>
#
# En production, utiliser un token EN LECTURE SEULE :
#   turso db tokens create <nom-de-la-base> --read-only
# L'application ne fait que des SELECT ; un token en lecture seule garantit
# côté base qu'une requête d'écriture ne peut pas aboutir, même si les
# garde-fous applicatifs venaient à être contournés.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Auth.js — générer avec: openssl rand -base64 32
AUTH_SECRET=""

# Clé API Groq — obtenir sur console.groq.com
GROQ_API_KEY=""

# URL de l'application
NEXTAUTH_URL="http://localhost:3000"

# Upstash Redis — limitation de débit de /api/chat (20 questions/heure/utilisateur)
# Obligatoire : sans ces variables, /api/chat renvoie une erreur 500.
#
# Deux conventions de nommage sont acceptées :
#  - Intégration Upstash de Vercel (Storage > Upstash for Redis) : les variables
#    KV_REST_API_URL et KV_REST_API_TOKEN sont injectées automatiquement,
#    il n'y a rien à recopier ici.
#  - Configuration manuelle (console.upstash.com) : renseigner les deux
#    variables ci-dessous.
#
# Le token doit être en lecture-écriture : la limitation de débit incrémente
# des compteurs (ne pas utiliser KV_REST_API_READ_ONLY_TOKEN).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
